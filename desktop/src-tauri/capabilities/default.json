{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "shell:allow-open",
    "store:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "updater:default"
  ]
}
